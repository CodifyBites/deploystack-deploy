# DeployStack — required environment variables.
#
# Copy to `.env` and fill in strong generated values. Never commit `.env`.
# Values are managed as protected variables in Arcane / coordinator secrets.
#
# Generate with e.g.:
#   openssl rand -base64 36

# PostgreSQL password for the deploystack database user (strong, generated).
POSTGRES_PASSWORD=

# Secret used to encrypt data at rest in the backend (strong, generated).
DEPLOYSTACK_ENCRYPTION_SECRET=
